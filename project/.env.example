# Founder Insights — environment variables
# Copy to .env.local for local development.

# ── Supabase (subscriber storage) ──────────────────────────────────
# Public URL of your Supabase project (visible to clients — safe).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key for client-side reads/inserts. Combined with row-level
# security policies this is safe to ship to the browser. Found under
# Project Settings → API → Project API keys → anon / public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# ── Admin page (/admin) ────────────────────────────────────────────
# Single-password gate for the captured-email list. Server-only — never
# expose with NEXT_PUBLIC_ prefix.
ADMIN_PASSWORD=change-me

# Optional: service-role key for server-side admin reads (bypasses RLS).
# Keep this server-side ONLY. Used by the /admin server component to
# list every subscribers row.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
